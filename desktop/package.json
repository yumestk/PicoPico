{
  "name": "pico-desktop",
  "productName": "Pico",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace companion for Pico",
  "author": "Pico contributors",
  "license": "UNLICENSED",
  "main": "build/main/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/host-client.test.cjs",
    "test:electron": "playwright test",
    "package": "npm run build && electron-forge package --arch=arm64 --platform=darwin"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
